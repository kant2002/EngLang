@using EngLang.Vm

<button class="btn btn-primary" @onclick="RunCode">Run</button>
@if (startDate.HasValue && endDate.HasValue)
{
    <text>Duration: (@(endDate.Value - startDate.Value).TotalSeconds)</text>
}
<h3 class="pt-1">Variables</h3>
<table class="table table-sm">
    <thead>
        <tr>
            <th>Variable</th>
            <th>Value</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var variableName in vm.GetVariableNames())
        {
            <tr>
                <td>@variableName</td>
                <td>@vm.GetVariableValue(variableName)</td>
            </tr>
        }
    </tbody>
</table>


<h3 class="pt-1">Functions</h3>
<table class="table table-sm">
    <thead>
        <tr>
            <th>Function</th>
            <th>Parameters</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var functionName in vm.GetFunctionNames())
        {
            <tr>
                <td>@functionName</td>
                <td>@string.Join(", ", vm.GetFunctionDeclaration(functionName)!.Parameters.Select(p => p.Name.Name))</td>
            </tr>
        }
    </tbody>
</table>


<h3 class="pt-1">Types</h3>
<table class="table table-sm">
    <thead>
        <tr>
            <th>Name</th>
            <th>Properties</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var typeName in vm.GetTypeNames())
        {
            <tr>
                <td>@typeName</td>
                <td>@string.Join(", ", vm.GetTypeDeclaration(typeName)!.Properties.Select(pair => $"{pair.Key}: {pair.Value.Name}"))</td>
            </tr>
        }
    </tbody>
</table>
<h3 class="pt-1">Constants</h3>
<table class="table table-sm">
    <thead>
        <tr>
            <th>Name</th>
            <th>Value</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var constName in vm.GetConstNames())
        {
            <tr>
                <td>@constName</td>
                <td>@vm.GetConstDeclaration(constName)!.Value</td>
            </tr>
        }
    </tbody>
</table>

@code {

    [Parameter]
    public string? SourceCode { get; set; }

    EngLangVm vm = new();
    DateTime? startDate;
    DateTime? endDate;

    void RunCode()
    {
        if (SourceCode is null)
        {
            return;
        }

        startDate = DateTime.Now;
        vm = new();
        vm.ExecuteCode(SourceCode);
        endDate = DateTime.Now;
    }
}
