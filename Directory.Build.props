<Project>
    <PropertyGroup>
        <TargetFramework Condition="$(MSBuildProjectExtension) == '.csproj'">net11.0</TargetFramework>
        <!-- Visual Studio don't support preview version of .NET so I can use this condition for fallback in case I don't have VS version which supports what I need. -->
        <TargetFramework Condition="$(MSBuildProjectExtension) == '.csproj' and ($(BuildingInsideVisualStudio) == true or '$(BuildingForLiveUnitTesting)' == 'true')">net11.0</TargetFramework>
        <AccelerateBuildsInVisualStudio>true</AccelerateBuildsInVisualStudio>
        <LangVersion>preview</LangVersion>
        <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    </PropertyGroup>
</Project>
